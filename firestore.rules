rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leagues: anyone can read public leagues, only admin owner can write
    match /leagues/{leagueId} {
      allow read: if resource.data.isPublic == true || request.auth != null && request.auth.uid == resource.data.adminId;
      allow create: if request.auth != null && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.adminId == request.auth.uid;

      // Teams: anyone can read (if parent league is public), only admin can write
      match /teams/{teamId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Players: public read, admin write
      match /players/{playerId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Games: public read, admin write
      match /games/{gameId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
